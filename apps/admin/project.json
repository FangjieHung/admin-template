{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "cli": {
    "cache": {
      "enabled": false
    }
  },
  "sourceRoot": "apps/admin/src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "apps/admin/src/main.ts",
        "tsConfig": "apps/admin/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/assets/image"
          }
        ],
        "styles": [
          "apps/admin/src/styles.scss",
          {
            "input": "libs/theme-pack/src/lib/styles/texture/linen/_index.scss",
            "bundleName": "texture-linen",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/grid/_index.scss",
            "bundleName": "texture-grid",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/soft-ui/_index.scss",
            "bundleName": "texture-soft-ui",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/clay/_index.scss",
            "bundleName": "texture-clay",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/editorial/_index.scss",
            "bundleName": "texture-editorial",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/frosted/_index.scss",
            "bundleName": "texture-frosted",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/aero/_index.scss",
            "bundleName": "texture-aero",
            "inject": false
          },
          {
            "input": "libs/theme-pack/src/lib/styles/texture/ledger/_index.scss",
            "bundleName": "texture-ledger",
            "inject": false
          }
        ],
        "stylePreprocessorOptions": { "includePaths": ["libs"] },
        "outputPath": "dist/admin-template"
      },
      "configurations": {
        "production": {
          "optimization": {
            "fonts": {
              "inline": false
            }
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "659kB",
              "maximumError": "850kB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kB",
              "maximumError": "12kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "admin:build:production"
        },
        "development": {
          "buildTarget": "admin:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
