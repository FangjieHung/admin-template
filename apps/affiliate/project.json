{
  "name": "affiliate",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "cli": {
    "cache": {
      "enabled": false
    }
  },
  "prefix": "app",
  "sourceRoot": "apps/affiliate/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/affiliate",
        "browser": "apps/affiliate/src/main.ts",
        "tsConfig": "apps/affiliate/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/affiliate/public"
          }
        ],
        "styles": ["apps/affiliate/src/styles.scss"],
        "stylePreprocessorOptions": { "includePaths": ["libs"] }
      },
      "configurations": {
        "production": {
          "optimization": {
            "fonts": {
              "inline": false
            }
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "430kb",
              "maximumError": "500kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4400
      },
      "configurations": {
        "production": {
          "buildTarget": "affiliate:build:production"
        },
        "development": {
          "buildTarget": "affiliate:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "affiliate:build",
        "staticFilePath": "dist/apps/affiliate/browser",
        "spa": true
      }
    }
  }
}
